Menu="Utilities"
Type="xmenu"
Title="Private Repo Sync"
Icon="private-repo-sync.png"
---
<?php
$name    = 'private-repo-sync';
$cfgfile = getenv('CA_CFG') ?: "/boot/config/plugins/$name/$name.cfg";
$script  = getenv('CA_SCRIPT') ?: "/boot/config/plugins/$name/$name.sh";
$csrf    = $var['csrf_token'] ?? '';

// The script reads the config as plain data, but every value is still validated down to a charset that cannot escape the quotes.
$cfg = ['REPOS' => '', 'SCHEDULE' => '17 * * * *', 'GITHUB_TOKEN' => ''];
if (is_file($cfgfile)) {
  foreach (file($cfgfile) as $line) {
    if (preg_match('/^(REPOS|SCHEDULE|GITHUB_TOKEN)="([^"]*)"\s*$/', $line, $m)) $cfg[$m[1]] = $m[2];
  }
}

$msg = ''; $out = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $csrf !== '' && hash_equals($csrf, $_POST['csrf_token'] ?? '')) {
  $action = $_POST['action'] ?? '';
  if ($action === 'save') {
    $repos = preg_split('/\s+/', trim($_POST['repos'] ?? ''), -1, PREG_SPLIT_NO_EMPTY);
    $sched = trim($_POST['schedule'] ?? '');
    $token = trim($_POST['token'] ?? '');
    if ($token === '') $token = $cfg['GITHUB_TOKEN'];
    $bad = array_filter($repos, fn($r) => !preg_match('#^[\w.-]+/[\w.-]+(@[\w./-]+)?$#', $r));
    if ($bad) {
      $msg = 'Invalid repo: ' . htmlspecialchars(implode(', ', $bad)) . ' (use user/repo or user/repo@branch)';
    } elseif (!preg_match('#^[0-9*/,-]+( [0-9*/,-]+){4}$#', $sched)) {
      $msg = 'Invalid schedule: need 5 cron fields, e.g. 17 * * * *';
    } elseif (!preg_match('/^[\w-]*$/', $token)) {
      $msg = 'Invalid token characters';
    } else {
      $cfg = ['REPOS' => implode(' ', $repos), 'SCHEDULE' => $sched, 'GITHUB_TOKEN' => $token];
      $body = '';
      foreach ($cfg as $k => $v) $body .= "$k=\"$v\"\n";
      @mkdir(dirname($cfgfile), 0755, true);
      file_put_contents($cfgfile, $body);
      shell_exec('/bin/bash ' . escapeshellarg($script) . ' cron 2>&1');
      $msg = 'Saved.';
    }
  } elseif ($action === 'sync') {
    $out = shell_exec('/bin/bash ' . escapeshellarg($script) . ' 2>&1') ?: '(no changes)';
  }
} elseif ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $msg = 'Bad CSRF token, reload the page.';
}

?>
<?php if ($msg): ?><p><strong><?=$msg?></strong></p><?php endif; ?>
<form method="post">
  <input type="hidden" name="csrf_token" value="<?=htmlspecialchars($csrf)?>">
  <table>
    <tr>
      <td><label for="repos">GitHub repos:</label></td>
      <td><textarea id="repos" name="repos" rows="5" cols="50" placeholder="user/repo&#10;user/repo@branch"><?=htmlspecialchars(str_replace(' ', "\n", $cfg['REPOS']))?></textarea></td>
    </tr>
    <tr>
      <td><label for="schedule">Sync schedule (cron):</label></td>
      <td><input type="text" id="schedule" name="schedule" value="<?=htmlspecialchars($cfg['SCHEDULE'])?>" style="width:150px"></td>
    </tr>
    <tr>
      <td><label for="token">GitHub token (optional):</label></td>
      <td>
        <input type="password" id="token" name="token" placeholder="<?=$cfg['GITHUB_TOKEN'] ? 'set, leave blank to keep' : 'for private repos / rate limit'?>" style="width:300px" autocomplete="off">
      </td>
    </tr>
    <tr><td></td><td><button name="action" value="save">Save</button> <button name="action" value="sync">Sync now</button></td></tr>
  </table>
</form>
<?php if ($out): ?><pre style="background:#1e1e1e;color:#ccc;padding:8px;border-radius:4px"><?=htmlspecialchars($out)?></pre><?php endif; ?>
